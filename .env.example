# Copier ce fichier en ".env" et adapter les valeurs pour l'environnement local.
# Ce fichier est lu par docker-compose ET transmis au conteneur API (pydantic-settings).

# --- Application ---
ENVIRONMENT=development
# Port exposé sur la machine hôte (le conteneur écoute toujours en interne sur 8000).
# Ajuster si le port est déjà utilisé par un autre projet local.
API_PORT=8001

# --- PostgreSQL ---
POSTGRES_USER=netmarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netmarket
# Port exposé sur l'hôte uniquement (utile pour un client DB externe) ; la
# communication interne api -> db utilise toujours db:5432, quel que soit ce port.
POSTGRES_PORT=55432
# Lue par l'API (asyncpg). Le host "db" correspond au nom du service docker-compose.
DATABASE_URL=postgresql+asyncpg://netmarket:change-me@db:5432/netmarket
# Base dédiée aux tests (créée automatiquement par backend/docker/init-test-db.sql) :
# les tests font drop_all/create_all à chaque lancement, donc jamais la même base que DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://netmarket:change-me@db:5432/netmarket_test

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Générer une valeur forte en production, ex: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Bootstrap admin (POST /auth/admin-bootstrap) ---
# Secret à usage unique pour créer le premier compte admin (refusé si un
# admin existe déjà). Génère une valeur forte, ex. la même commande que
# JWT_SECRET_KEY ci-dessus. Laisser vide désactive l'endpoint.
ADMIN_BOOTSTRAP_TOKEN=

# --- Email (codes de vérification, mot de passe oublié, notifications) ---
# Envoi via l'API transactionnelle Brevo (https://api.brevo.com) — sans clé,
# les emails sont juste loggés (voir backend/app/core/email.py), aucun
# compte externe n'est requis pour développer/tester.
# Clé API : https://app.brevo.com/settings/keys/api. L'adresse d'expéditeur
# doit être un domaine/expéditeur validé sur le compte Brevo.
# BREVO_API_KEY=xxxxxxxxxxxxxxxx
BREVO_SENDER_NAME="Marketplace Guinée"
BREVO_SENDER_EMAIL=no-reply@netmarket.ndjouri.com

# --- Paiement en ligne (Djomy) ---
# Sans clé, seul le paiement à la livraison reste proposé au checkout (voir
# backend/app/payments/provider.py). Identifiants sandbox :
# https://developers.djomy.africa (créer un compte d'essai dans l'espace
# développeur). FRONTEND_URL sert à composer l'URL de retour après paiement.
# DJOMY_CLIENT_ID=djomy-client-xxxxxxxxxxxxx-xxxx
# DJOMY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DJOMY_BASE_URL=https://sandbox-api.djomy.africa
FRONTEND_URL=http://localhost:3000

# --- Stockage images produit (MinIO, S3-compatible, self-hosted) ---
MINIO_ROOT_USER=netmarket
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Lu par l'API (réseau docker interne) — le host "minio" correspond au service docker-compose.
# Le navigateur ne parle jamais directement à MinIO : les images passent par
# GET /uploads/images/{key} côté API (voir app/uploads/router.py).
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=netmarket
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=product-images
